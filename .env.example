# Application Environment
ENV=development
PORT=8080

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/pet_platform?sslmode=disable

# Cache & Local Message Broker
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-vault
JWT_ACCESS_EXPIRY_HR=24
JWT_REFRESH_EXPIRY_HR=720

# Public URLs & Deep Linking
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=*

# Object Storage (S3 / Cloudflare R2 Compatible)
S3_BUCKET=pet-identity-assets
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
